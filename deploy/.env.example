# Telegram Bot Token (BotFather'dan alinir)
TELEGRAM_BOT_TOKEN=

# Bildirimlerin gidecegi sohbet / kanal ID
TELEGRAM_CHAT_ID=

# Sistem yoneticisi (admin) Telegram ID
ADMIN_CHAT_ID=

# Google Gemini API anahtari (ilan analizi icin)
GEMINI_API_KEY=

# Durum dosyalarini git'e de yedekle (true/false)
ISKUR_GIT_BACKUP=false
